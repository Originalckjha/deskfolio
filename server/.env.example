# ---- Server ----
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins (local + Vercel)
CLIENT_ORIGINS=http://localhost:5173,https://deskfolio.vercel.app

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/deskfolio?retryWrites=true&w=majority

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ---- Cloudinary (file uploads: PDF, PPT, images) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=deskfolio
MAX_UPLOAD_MB=15

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---- Bayesian ranking ----
RANKING_MIN_REVIEWS_M=10
RANKING_BASELINE_C=4.0
